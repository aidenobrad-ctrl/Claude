/* Pulsebreak HUD. Sizes are in reference pixels: the panel scales from 1920x1080 by screen height. */

.hud {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    color: rgb(240, 244, 250);
    font-size: 16px;
}

.layer {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.panel {
    position: absolute;
    padding: 12px 16px;
    background-color: rgba(10, 14, 20, 0.55);
    border-radius: 6px;
    border-left-width: 3px;
    border-left-color: rgb(38, 216, 255);
}

.panel-title {
    font-size: 13px;
    letter-spacing: 3px;
    color: rgb(38, 216, 255);
    -unity-font-style: bold;
    margin-bottom: 6px;
}

/* ---------------------------------------------------------------- crosshair */

/* A zero-size anchor at screen centre; the lines are placed around it from code. */
.crosshair {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 0;
    height: 0;
}

.ch-line {
    position: absolute;
    background-color: rgb(255, 255, 255);
    border-width: 1px;
    border-color: rgba(0, 0, 0, 0.55);
}

.ch-dot {
    position: absolute;
    left: -2px;
    top: -2px;
    width: 4px;
    height: 4px;
    border-radius: 2px;
    background-color: rgb(255, 255, 255);
    border-width: 1px;
    border-color: rgba(0, 0, 0, 0.55);
}

/* Four ticks laid out as a plus, then turned 45 degrees into an X. */
.hitmarker {
    position: absolute;
    left: 0;
    top: 0;
    width: 0;
    height: 0;
    rotate: 45deg;
    opacity: 0;
}

.hm-tick {
    position: absolute;
    background-color: rgb(255, 255, 255);
}

.hm-top { left: -1.5px; top: -20px; width: 3px; height: 11px; }
.hm-bottom { left: -1.5px; top: 9px; width: 3px; height: 11px; }
.hm-left { left: -20px; top: -1.5px; width: 11px; height: 3px; }
.hm-right { left: 9px; top: -1.5px; width: 11px; height: 3px; }

.rangefinder {
    position: absolute;
    left: 50%;
    top: 50%;
    margin-left: 34px;
    margin-top: 18px;
    font-size: 14px;
    color: rgba(240, 244, 250, 0.75);
    text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.9);
}

/* Thin bars under the crosshair: reload progress and charge. */
.center-bar {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 120px;
    height: 5px;
    margin-left: -60px;
    background-color: rgba(10, 14, 20, 0.7);
    border-radius: 3px;
    display: none;
}

.center-fill {
    height: 100%;
    width: 0;
    border-radius: 3px;
}

.reload-bar { margin-top: 54px; }
.reload-fill { background-color: rgb(38, 216, 255); }
.charge-bar { margin-top: 40px; }
.charge-fill { background-color: rgb(255, 196, 64); }

/* ---------------------------------------------------------------- optics */

/* Drawn at screen centre while aiming with an optic. Opacity is driven from code. */
.reticle {
    position: absolute;
    left: 0;
    top: 0;
    width: 0;
    height: 0;
    opacity: 0;
}

.ret-dot {
    position: absolute;
    left: -3px;
    top: -3px;
    width: 6px;
    height: 6px;
    border-radius: 3px;
    background-color: rgb(255, 60, 48);
    display: none;
}

.ret-shape {
    position: absolute;
    left: 0;
    top: 0;
    width: 0;
    height: 0;
    display: none;
}

.ret-line {
    position: absolute;
    background-color: rgb(255, 60, 48);
}

.ret-cross-h { left: -16px; top: -1px; width: 32px; height: 2px; }
.ret-cross-v { left: -1px; top: -16px; width: 2px; height: 32px; }
.ret-chevron-l { left: -13px; top: 4px; width: 15px; height: 3px; rotate: -40deg; }
.ret-chevron-r { left: -2px; top: 4px; width: 15px; height: 3px; rotate: 40deg; }

/* Full-screen scope: black bars either side of a square lens image. */
.scope {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    flex-direction: row;
    display: none;
}

.scope-bar {
    flex-grow: 1;
    background-color: rgb(0, 0, 0);
}

.scope-lens {
    height: 100%;
    flex-shrink: 0;
}

/* ---------------------------------------------------------------- panels */

.hints {
    left: 28px;
    top: 28px;
}

.hint {
    font-size: 14px;
    color: rgba(240, 244, 250, 0.82);
    margin-top: 1px;
}

.range-stats {
    right: 28px;
    top: 28px;
    min-width: 230px;
}

.stat {
    font-size: 15px;
    margin-top: 1px;
}

.movement {
    left: 28px;
    bottom: 28px;
    min-width: 150px;
}

.move-state {
    font-size: 13px;
    letter-spacing: 3px;
    color: rgb(38, 216, 255);
    -unity-font-style: bold;
}

.move-speed {
    font-size: 26px;
    -unity-font-style: bold;
}

.ammo {
    right: 28px;
    bottom: 28px;
    min-width: 190px;
    align-items: flex-end;
    border-left-width: 0;
    border-right-width: 3px;
    border-right-color: rgb(38, 216, 255);
}

.slots {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 24px;
    flex-direction: row;
    justify-content: center;
    align-items: flex-end;
}

/* One weapon slot along the bottom centre: key, kind of slot, weapon. */
.slot {
    width: 200px;
    margin-left: 5px;
    margin-right: 5px;
    padding: 7px 12px 9px 12px;
    background-color: rgba(10, 14, 20, 0.66);
    border-radius: 6px;
    border-top-width: 3px;
    border-top-color: rgba(240, 244, 250, 0.2);
}

.slot--active {
    background-color: rgba(38, 216, 255, 0.94);
    border-top-color: rgb(255, 255, 255);
    translate: 0 -6px;
}

.slot--empty {
    opacity: 0.35;
}

.slot-head {
    flex-direction: row;
    align-items: center;
}

.slot-key {
    font-size: 13px;
    -unity-font-style: bold;
    color: rgb(6, 20, 26);
    background-color: rgb(38, 216, 255);
    border-radius: 3px;
    padding: 0 6px;
    margin-right: 8px;
}

.slot--active .slot-key {
    color: rgb(38, 216, 255);
    background-color: rgb(6, 20, 26);
}

.slot-role {
    font-size: 11px;
    letter-spacing: 2px;
    color: rgba(240, 244, 250, 0.6);
}

.slot--active .slot-role {
    color: rgba(6, 20, 26, 0.75);
}

.slot-name {
    font-size: 17px;
    -unity-font-style: bold;
    margin-top: 4px;
    color: rgb(240, 244, 250);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.slot--active .slot-name {
    color: rgb(6, 20, 26);
}

.weapon-name {
    font-size: 13px;
    letter-spacing: 3px;
    color: rgb(38, 216, 255);
    -unity-font-style: bold;
}

.ammo-row {
    flex-direction: row;
    align-items: flex-end;
}

.ammo-mag {
    font-size: 46px;
    -unity-font-style: bold;
}

.ammo-mag--low {
    color: rgb(255, 92, 72);
}

.ammo-reserve {
    font-size: 20px;
    margin-left: 8px;
    margin-bottom: 8px;
    color: rgba(240, 244, 250, 0.7);
}

.weapon-status {
    font-size: 13px;
    letter-spacing: 2px;
    color: rgb(255, 196, 64);
    min-height: 18px;
}

/* ---------------------------------------------------------------- damage numbers */

.damage-number {
    position: absolute;
    translate: -50% -50%;
    font-size: 24px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
    text-shadow: 1px 1px 3px rgba(0, 0, 0, 0.95);
    display: none;
}

/* ---------------------------------------------------------------- pause menu */

.pause {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    background-color: rgba(6, 9, 14, 0.78);
    display: none;
}

.pause-card {
    padding: 28px 32px;
    margin: 0 14px;
    background-color: rgb(18, 23, 32);
    border-radius: 10px;
    border-top-width: 3px;
    border-top-color: rgb(38, 216, 255);
}

.settings-card {
    width: 470px;
}

.loadouts-card {
    width: 1210px;
    height: 800px;
}

.pause-title {
    font-size: 30px;
    letter-spacing: 6px;
    -unity-font-style: bold;
    margin-bottom: 18px;
}

.pause-card .unity-base-field {
    margin-top: 8px;
    margin-bottom: 8px;
}

.pause-card .unity-base-field__label {
    min-width: 170px;
    color: rgb(240, 244, 250);
    font-size: 16px;
}

.pause-card .unity-text-field__input {
    min-width: 64px;
}

.pause-buttons {
    flex-direction: row;
    justify-content: flex-end;
    margin-top: 22px;
}

.pause-button {
    min-width: 120px;
    height: 40px;
    margin-left: 10px;
    font-size: 16px;
    color: rgb(240, 244, 250);
    background-color: rgb(40, 48, 62);
    border-width: 0;
    border-radius: 6px;
}

.pause-button:hover {
    background-color: rgb(56, 66, 84);
}

.pause-button.primary {
    color: rgb(6, 20, 26);
    background-color: rgb(38, 216, 255);
    -unity-font-style: bold;
}

.pause-button.primary:hover {
    background-color: rgb(120, 232, 255);
}

/* ---------------------------------------------------------------- armory */

.armory-tabs {
    flex-direction: row;
    margin-bottom: 14px;
}

.armory-tab {
    height: 34px;
    min-width: 130px;
    margin: 0 8px 0 0;
    font-size: 14px;
    letter-spacing: 2px;
    color: rgb(240, 244, 250);
    background-color: rgb(40, 48, 62);
    border-width: 0;
    border-radius: 6px;
}

.armory-tab--active {
    color: rgb(6, 20, 26);
    background-color: rgb(38, 216, 255);
    -unity-font-style: bold;
}

.armory-body {
    flex-direction: row;
    flex-grow: 1;
}

.armory-weapons {
    width: 260px;
    margin-right: 22px;
}

.armory-weapon {
    height: 34px;
    margin: 0 6px 4px 0;
    padding-left: 12px;
    font-size: 15px;
    -unity-text-align: middle-left;
    color: rgb(240, 244, 250);
    background-color: rgb(28, 34, 46);
    border-width: 0;
    border-radius: 5px;
}

.armory-weapon:hover {
    background-color: rgb(44, 53, 70);
}

.armory-weapon--active {
    background-color: rgb(38, 216, 255);
    color: rgb(6, 20, 26);
    -unity-font-style: bold;
}

.armory-group {
    font-size: 12px;
    letter-spacing: 3px;
    color: rgb(38, 216, 255);
    margin: 10px 0 5px 2px;
}

.armory-detail {
    flex-grow: 1;
}

.armory-name {
    font-size: 26px;
    -unity-font-style: bold;
}

.armory-class {
    font-size: 12px;
    letter-spacing: 3px;
    color: rgb(38, 216, 255);
    margin-bottom: 6px;
}

.armory-description {
    font-size: 14px;
    color: rgba(240, 244, 250, 0.75);
    white-space: normal;
    min-height: 38px;
    margin-bottom: 8px;
}

.armory-attachments {
    margin-bottom: 10px;
}

.attachment-row {
    flex-direction: row;
    align-items: center;
    height: 30px;
    margin-bottom: 3px;
}

.attachment-slot {
    width: 92px;
    font-size: 12px;
    letter-spacing: 2px;
    color: rgba(240, 244, 250, 0.6);
}

.attachment-step {
    width: 30px;
    height: 26px;
    margin: 0;
    padding: 0;
    font-size: 15px;
    color: rgb(240, 244, 250);
    background-color: rgb(40, 48, 62);
    border-width: 0;
    border-radius: 5px;
}

.attachment-step:hover {
    background-color: rgb(56, 66, 84);
}

.attachment-name {
    width: 170px;
    font-size: 15px;
    -unity-text-align: middle-center;
}

.attachment-effect {
    flex-grow: 1;
    font-size: 12px;
    color: rgba(240, 244, 250, 0.6);
    margin-left: 8px;
    white-space: normal;
}

.bar-row {
    flex-direction: row;
    align-items: center;
    height: 20px;
}

.bar-label {
    width: 120px;
    font-size: 13px;
    color: rgba(240, 244, 250, 0.8);
}

.bar-track {
    flex-grow: 1;
    height: 8px;
    background-color: rgb(34, 41, 54);
    border-radius: 4px;
}

/* The base weapon's value, then the part an attachment added or took away. */
.bar-base {
    position: absolute;
    left: 0;
    top: 0;
    height: 100%;
    background-color: rgb(210, 218, 230);
    border-radius: 4px;
}

.bar-change {
    position: absolute;
    top: 0;
    height: 100%;
}

.bar-change--better { background-color: rgb(64, 220, 120); }
.bar-change--worse { background-color: rgb(255, 92, 72); }

.armory-numbers {
    margin-top: 10px;
    font-size: 14px;
    color: rgba(240, 244, 250, 0.85);
    white-space: normal;
}

/* ---------------------------------------------------------------- loadouts */

.loadouts-body {
    flex-direction: row;
    flex-grow: 1;
}

.loadouts-column {
    width: 230px;
    margin-right: 22px;
}

.loadout-list {
    flex-grow: 1;
}

.loadout-actions {
    flex-direction: row;
    margin-top: 10px;
}

.loadout-actions .pause-button {
    min-width: 0;
    flex-grow: 1;
    margin: 0 6px 0 0;
}

.loadout-editor {
    flex-grow: 1;
}

.loadout-name {
    margin: 0 0 4px 0;
    font-size: 20px;
}

.loadout-name .unity-text-field__input {
    padding: 4px 10px;
    color: rgb(240, 244, 250);
    background-color: rgb(28, 34, 46);
    border-color: rgb(56, 66, 84);
    border-radius: 5px;
}

.loadout-note {
    font-size: 12px;
    color: rgba(240, 244, 250, 0.6);
    white-space: normal;
    margin: 4px 0 10px 2px;
}

/* On the HUD: the loadout in use, above the weapon slots. */
.loadout-title {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 94px;
    -unity-text-align: middle-center;
    font-size: 12px;
    letter-spacing: 3px;
    color: rgb(38, 216, 255);
    -unity-font-style: bold;
}

/* On the HUD: the two utility items, left of the ammo panel. */
.utilities {
    position: absolute;
    right: 250px;
    bottom: 28px;
    align-items: flex-end;
}

.utility {
    flex-direction: row;
    align-items: center;
    margin-top: 4px;
    padding: 4px 10px;
    background-color: rgba(10, 14, 20, 0.55);
    border-radius: 4px;
}

.utility--empty {
    opacity: 0.4;
}

.utility-key {
    width: 20px;
    font-size: 13px;
    color: rgb(38, 216, 255);
    -unity-font-style: bold;
}

.utility-name {
    font-size: 13px;
    letter-spacing: 1px;
    margin-right: 10px;
}

.utility-count {
    font-size: 16px;
    -unity-font-style: bold;
    min-width: 26px;
    -unity-text-align: middle-right;
}

/* Quick swap overlay. */
.quick {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(6, 9, 14, 0.55);
    display: none;
}

.quick-card {
    width: 380px;
}

.quick-item {
    height: 36px;
    margin: 0 0 5px 0;
    padding-left: 12px;
    font-size: 16px;
    -unity-text-align: middle-left;
    color: rgb(240, 244, 250);
    background-color: rgb(28, 34, 46);
    border-width: 0;
    border-radius: 5px;
}

.quick-item:hover {
    background-color: rgb(44, 53, 70);
}

.quick-item--active {
    background-color: rgb(38, 216, 255);
    color: rgb(6, 20, 26);
    -unity-font-style: bold;
}

/* ---------------------------------------------------------------- loadout list entries */

.loadout-entry {
    flex-direction: column;
    align-items: flex-start;
    height: auto;
    padding-top: 6px;
    padding-bottom: 6px;
}

.loadout-entry-name {
    font-size: 16px;
    -unity-font-style: bold;
}

.loadout-entry-contents {
    font-size: 11px;
    color: rgba(240, 244, 250, 0.62);
    white-space: normal;
    margin-top: 2px;
}

.deploy-button {
    margin-left: 0;
    margin-top: 10px;
    height: 46px;
    font-size: 18px;
}
