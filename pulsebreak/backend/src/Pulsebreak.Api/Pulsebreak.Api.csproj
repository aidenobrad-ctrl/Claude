<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Pulsebreak.Api</RootNamespace>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Konscious.Security.Cryptography.Argon2" Version="1.3.1" />
    <PackageReference Include="MailKit" Version="4.18.2" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.15" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.15">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
    <!-- Named outright so everything that references this project gets the same Entity Framework version the tools use. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.15" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageReference Include="StackExchange.Redis" Version="2.13.23" />
  </ItemGroup>

  <!--
    The stored loadout format, the rule for merging two copies of it, the join ticket a game
    server checks and the playlists matchmaking fills are the game's own source files,
    compiled in here as well. The game
    and the backend cannot drift apart on any of them, because there is only one of each.
    Those files may use nothing but System.
  -->
  <ItemGroup>
    <Compile Include="../../../game/Assets/_Project/Shared/Loadouts/LoadoutData.cs" Link="Shared/LoadoutData.cs" />
    <Compile Include="../../../game/Assets/_Project/Shared/Loadouts/LoadoutSync.cs" Link="Shared/LoadoutSync.cs" />
    <Compile Include="../../../game/Assets/_Project/Shared/Net/GameTicket.cs" Link="Shared/GameTicket.cs" />
    <Compile Include="../../../game/Assets/_Project/Shared/Match/Playlists.cs" Link="Shared/Playlists.cs" />
    <Compile Include="../../../game/Assets/_Project/Shared/Progression/Progression.cs" Link="Shared/Progression.cs" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Pulsebreak.Api.Tests" />
  </ItemGroup>

</Project>
