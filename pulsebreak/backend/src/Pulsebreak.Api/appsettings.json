{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Postgres": "",
    "Redis": "localhost:6379"
  },
  "Auth": {
    "JwtSigningKey": "",
    "Issuer": "pulsebreak",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 30,
    "Argon2MemoryKb": 19456,
    "Argon2Iterations": 2,
    "Argon2Parallelism": 1,
    "MaxFailedLogins": 5,
    "LockoutSeconds": 60,
    "MaxLockoutSeconds": 900,
    "EmailCodeMinutes": 1440,
    "ResetCodeMinutes": 30,
    "MaxCodeAttempts": 5,
    "EmailCooldownSeconds": 60
  },
  "Game": {
    "TicketSigningKey": "",
    "TicketSeconds": 60
  },
  "Email": {
    "Mode": "Log",
    "From": "Pulsebreak <no-reply@pulsebreak.localhost>",
    "SmtpHost": "",
    "SmtpPort": 587,
    "SmtpUser": "",
    "SmtpPassword": "",
    "SmtpStartTls": true,
    "FileDirectory": "emails",
    "PublicBaseUrl": "http://localhost:5080"
  },
  "Matchmaking": {
    "FleetKey": "",
    "FillAfterSeconds": 20,
    "TicketIdleSeconds": 20,
    "HeartbeatSeconds": 3,
    "ServerTimeoutSeconds": 15,
    "GuestPassHours": 12,
    "IntervalMilliseconds": 1000
  },
  "RateLimits": {
    "AuthPerMinute": 20,
    "GeneralPerMinute": 300,
    "TrustForwardedHeaders": false
  },
  "Database": {
    "MigrateOnStartup": false
  }
}
